{
  "name": "@geo-content-os/adapter-storage",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "GEO Content OS — S3-compatible private object storage Adapter",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json --pretty false",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --project tsconfig.json --noEmit --pretty false"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1086.0",
    "@aws-sdk/s3-request-presigner": "^3.1086.0"
  },
  "devDependencies": {
    "vitest": "4.1.10"
  },
  "files": [
    "dist"
  ]
}
