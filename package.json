{
  "name": "geo-content-os",
  "version": "0.0.0",
  "private": true,
  "description": "GEO Content OS — 企业级 GEO 多平台内容生产系统 (MVP v1.0)",
  "engines": {
    "node": ">=22.0.0 <23.0.0",
    "pnpm": ">=10.0.0 <11.0.0"
  },
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "clean": "pnpm -r exec rm -rf dist/ .next/ node_modules/.cache",
    "commitlint": "commitlint --from HEAD~1 --to HEAD --verbose",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --max-warnings=0 --fix",
    "test": "node scripts/task-gate.mjs T008",
    "typecheck": "tsc --project tsconfig.json --noEmit --pretty false"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.1",
    "eslint": "9.39.5",
    "globals": "17.7.0",
    "prettier": "3.9.5",
    "typescript": "5.8.3",
    "typescript-eslint": "8.64.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Zhangzhuangzhuang618/GEO-Content-OS.git"
  },
  "license": "UNLICENSED",
  "author": ""
}
