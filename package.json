{
  "name": "geo-content-os",
  "version": "0.0.0",
  "private": true,
  "description": "GEO Content OS — 企业级 GEO 多平台内容生产系统 (MVP v1.0)",
  "engines": {
    "node": ">=22.0.0 <23.0.0",
    "pnpm": ">=10.0.0 <11.0.0"
  },
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "clean": "pnpm -r exec rm -rf dist/ .next/ node_modules/.cache",
    "commitlint": "commitlint --from HEAD~1 --to HEAD --verbose",
    "db:check": "pnpm --filter @geo-content-os/api db:check",
    "db:generate": "pnpm --filter @geo-content-os/api db:generate",
    "db:migrate": "pnpm --filter @geo-content-os/api db:migrate",
    "db:migrate:fresh": "pnpm --filter @geo-content-os/api db:migrate:fresh",
    "db:test": "pnpm --filter @geo-content-os/api test:database",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --max-warnings=0 --fix",
    "test": "pnpm test:unit && pnpm test:integration && pnpm test:e2e",
    "test:e2e": "pnpm --filter web build && playwright test",
    "test:integration": "pnpm --filter api test:integration",
    "test:security": "pnpm --filter security test:security && pnpm --filter api test:security && pnpm --filter web test:security",
    "test:unit": "pnpm --filter contracts test && pnpm --filter security test && pnpm --filter observability test && pnpm --filter testkit test && pnpm --filter worker-outbox-relay test && pnpm --filter api test",
    "typecheck": "pnpm typecheck:root && pnpm --recursive --if-present typecheck",
    "typecheck:root": "tsc --project tsconfig.json --noEmit --pretty false"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@eslint/js": "9.39.5",
    "@next/eslint-plugin-next": "15.5.20",
    "@playwright/test": "1.61.1",
    "@types/node": "22.20.1",
    "eslint": "9.39.5",
    "globals": "17.7.0",
    "prettier": "3.9.5",
    "typescript": "5.8.3",
    "typescript-eslint": "8.64.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Zhangzhuangzhuang618/GEO-Content-OS.git"
  },
  "license": "UNLICENSED",
  "author": ""
}
