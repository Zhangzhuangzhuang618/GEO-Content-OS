# Local development only. Replace every credential outside an isolated developer machine.
COMPOSE_PROJECT_NAME=geo-content-os

POSTGRES_DB=geo_content_os_dev
POSTGRES_USER=geo
POSTGRES_PASSWORD=geo_local_password
POSTGRES_PORT=5432

REDIS_PORT=6379

MINIO_ROOT_USER=geo_minio
MINIO_ROOT_PASSWORD=geo_minio_local_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET=geo-content-os-dev
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=geo_minio
S3_SECRET_ACCESS_KEY=geo_minio_local_password
S3_FORCE_PATH_STYLE=true
S3_AUTO_CREATE_BUCKET=true
S3_SERVER_SIDE_ENCRYPTION=false
SOURCE_UPLOAD_MAX_BYTES=26214400
WEB_FETCH_MAX_BYTES=10485760
WEB_FETCH_TIMEOUT_MS=10000
WEB_FETCH_MAX_REDIRECTS=5
WEB_FETCH_ALLOWED_PORTS=80,443
WEB_FETCH_ALLOWED_HOSTS=
WEB_FETCH_DENIED_HOSTS=
WEB_FETCH_USER_AGENT=GEO-Content-OS-WebFetch/1.0
KNOWLEDGE_WORKER_CONCURRENCY=2
EMBEDDING_DRIVER=local
EMBEDDING_MODEL_KEY=embedding-local-ngram-v1
EMBEDDING_MAX_BATCH_SIZE=64
RERANK_DRIVER=local
RERANK_MODEL_KEY=rerank-local-ngram-v1
# Image sources require a configured OCR provider. PDF, DOCX, TXT and URL do not.
OCR_DRIVER=disabled

API_PORT=3001
API_BIND_ADDRESS=127.0.0.1
WEB_PORT=3000
AUTH_COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# The Web container is the only trusted proxy hop. Keep the API port bound to localhost.
TRUST_PROXY_HOPS=1
# General reads use this limit. Authentication writes are capped at 30/minute and other writes at
# 120/minute; each category has an independent bucket for the real client IP.
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_REDIS_URL=redis://localhost:6379/1

# Optional thin connector to the independently deployed Wentian system. Leave all four values
# empty to disable it without affecting GEO. The secret is shown only once when an active Wentian
# administrator creates or rotates a connector; never expose it to the browser.
WENTIAN_BASE_URL=
WENTIAN_GEO_CONNECTOR_ID=
WENTIAN_GEO_CONNECTOR_SECRET=
WENTIAN_GEO_TENANT_ID=

# Content generation. With no API key, local Compose uses the deterministic Mock model.
# Set AI_MODEL_DRIVER=deepseek and DEEPSEEK_API_KEY to enable real model calls.
AI_MODEL_DRIVER=
AI_WORKER_CONCURRENCY=2
# Database polling interval for official-site daily batches (5–300 seconds).
OFFICIAL_SITE_DAILY_TICK_MS=30000
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL_KEY=deepseek-v4-flash
DEEPSEEK_PROVIDER_MODEL_ID=deepseek-v4-flash
DEEPSEEK_MAX_OUTPUT_TOKENS=32768
DEEPSEEK_MAX_RETRIES=2
DEEPSEEK_RETRY_BASE_DELAY_MS=500
DEEPSEEK_TIMEOUT_MS=300000
CONTENT_MODEL_FAST_KEY=deepseek-v4-flash
CONTENT_MODEL_BALANCED_KEY=deepseek-v4-flash
CONTENT_MODEL_QUALITY_KEY=deepseek-v4-pro
CONTENT_WRITER_PROMPT_VERSION_ID=25000000-0000-4000-8000-000000000008
CONTENT_WRITER_SKILL_VERSION=1.0.0
QUALITY_CHECKER_MODEL_KEY=deepseek-v4-pro
QUALITY_CHECKER_PROMPT_VERSION_ID=25000000-0000-4000-8000-000000000007
QUALITY_CHECKER_SKILL_VERSION=1.0.0
CONTENT_REQUIRE_PLATFORM_ACCOUNTS=true
# Required in production. JSON object keyed by all enabled platform codes.
CONTENT_PLATFORM_RULES_JSON=

# T148 content images. The planner uses DeepSeek; generation and image QA use Cloudflare Workers AI.
# Keep the driver disabled until the Cloudflare account has accepted the vision model licence.
IMAGE_AUTOMATION_ENABLED=true
IMAGE_PLANNER_MODEL_KEY=deepseek-v4-flash
IMAGE_GENERATION_DRIVER=disabled
IMAGE_GENERATION_STEPS=4
IMAGE_PROVIDER_TIMEOUT_MS=120000
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
CLOUDFLARE_IMAGE_QA_MODEL=@cf/meta/llama-3.2-11b-vision-instruct
# Optional legacy CDN prefix for S3 object keys. Keep this empty when the official-site API advertises
# media_upload=true: Publisher then uploads MinIO bytes to the site before publishing the article.
GENERATED_MEDIA_PUBLIC_BASE_URL=

# Generate a unique 32-byte local key with: openssl rand -base64 32
PUBLISHING_CREDENTIAL_KEY_BASE64=
PUBLISHING_CREDENTIAL_KEY_VERSION=local-v1
PUBLISHER_WORKER_CONCURRENCY=2
PUBLISHER_STALE_AFTER_MS=120000

# Internal API/Publisher <-> hosted Baijiahao browser gateway secret. Generate at least 32 random
# characters and never reuse a Baidu password or expose this port publicly.
BAIJIAHAO_BROWSER_GATEWAY_TOKEN=
BAIJIAHAO_BROWSER_GATEWAY_TIMEOUT_MS=65000
BAIJIAHAO_BROWSER_HEADLESS=true
BAIJIAHAO_BROWSER_PROFILE_ROOT=/var/lib/geo-content-os/baijiahao
BAIJIAHAO_BROWSER_SIMULATOR=false
BAIJIAHAO_BROWSER_NAVIGATION_TIMEOUT_MS=30000
BAIJIAHAO_LOGIN_URL=https://baijiahao.baidu.com/
BAIJIAHAO_EDITOR_URL=https://baijiahao.baidu.com/builder/rc/edit?type=news
BAIJIAHAO_MANAGE_URL=https://baijiahao.baidu.com/builder/rc/content

# Internal API/Publisher <-> hosted Sohu browser gateway secret. This is not a Sohu password.
SOHU_BROWSER_GATEWAY_TOKEN=
SOHU_BROWSER_GATEWAY_TIMEOUT_MS=65000
SOHU_BROWSER_HEADLESS=true
SOHU_BROWSER_PROFILE_ROOT=/var/lib/geo-content-os/sohu
SOHU_BROWSER_SIMULATOR=false
SOHU_BROWSER_NAVIGATION_TIMEOUT_MS=30000
SOHU_LOGIN_URL=https://mp.sohu.com/mpfe/v4/signin
SOHU_EDITOR_URL=https://mp.sohu.com/mpfe/v4/contentManagement/news/addarticle?contentStatus=1
SOHU_MANAGE_URL=https://mp.sohu.com/mpfe/v4/contentManagement/first/page

# Internal API/Publisher <-> hosted Lieju browser gateway secret. This is not a Lieju password.
LIEJU_BROWSER_GATEWAY_TOKEN=
LIEJU_BROWSER_GATEWAY_TIMEOUT_MS=65000
LIEJU_BROWSER_HEADLESS=true
LIEJU_BROWSER_PROFILE_ROOT=/var/lib/geo-content-os/lieju
LIEJU_BROWSER_SIMULATOR=false
LIEJU_BROWSER_NAVIGATION_TIMEOUT_MS=30000
LIEJU_LOGIN_URL=https://www.lieju.com/qq_login/
LIEJU_EDITOR_URL=https://post.lieju.com/5/73
LIEJU_MANAGE_URL=https://www.lieju.com/member/list.php

# Topic Planner generation provenance. Development defaults are deterministic mock values.
TOPIC_PLANNER_MODEL_KEY=mock-topic-planner
TOPIC_PLANNER_PROMPT_VERSION_ID=00000000-0000-4000-8000-000000000026
TOPIC_PLANNER_SKILL_VERSION=1.0.0

# Identity email delivery. Keep disabled locally; production requires smtp and HTTPS PUBLIC_APP_URL.
EMAIL_TRANSPORT=disabled
PUBLIC_APP_URL=http://localhost:3000
EMAIL_FROM=GEO Content OS <no-reply@localhost>
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
